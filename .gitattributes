# Auto detect text files and perform LF normalization
* text=auto

# Ensure gradlew has LF line endings
/gradlew text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Android / Gradle configuration
*.gradle text eol=lf
*.gradle.kts text eol=lf
*.properties text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.apk binary
*.aab binary
*.webp binary
